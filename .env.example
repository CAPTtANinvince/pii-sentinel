# Server-side only. Never prefix these with VITE_: they must not reach the browser.

# Sapling PII detection (Stage B)
SAPLING_API_KEY=

# Google Cloud Sensitive Data Protection (Stage C)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Self-hosted Presidio analyzer (Stage D)
PRESIDIO_ANALYZER_URL=

# Optional: extra origins allowed to call /api (comma-separated, e.g. https://example.com)
ALLOWED_ORIGINS=
# Optional tuning
RATE_LIMIT_PER_MINUTE=30
PROVIDER_TIMEOUT_MS=10000

# Frontend (public)
VITE_USE_MOCK_API=true
VITE_API_BASE_URL=
